# Cluster the scripts talk to: devnet | testnet | mainnet-beta | localnet
CLUSTER=devnet

# Optional: your own RPC (Helius, Triton, ...). Defaults to the public endpoint for CLUSTER.
# RPC_URL=https://api.devnet.solana.com
# WS_URL=wss://api.devnet.solana.com

# Main wallet: pays fees, is the mint authority and the NFT update authority.
# Defaults to the Solana CLI wallet (~/.config/solana/id.json).
# AUTHORITY_KEYPAIR=~/.config/solana/id.json

# Second wallet that receives the tokens and the NFT. Created by `pnpm wallets`.
# RECIPIENT_KEYPAIR=./wallets/recipient.json
